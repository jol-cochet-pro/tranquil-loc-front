rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
  	function isSignedIn() {
    	return request.auth != null;
    }
    // Make the user data only available for the authenticated user
    match /users/{userId} {
      allow read, update, delete: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn();

      match /occupants/{occupantId} {
          allow read, update, delete, create: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}